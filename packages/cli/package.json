{
  "name": "@jackkoskie/docengine",
  "version": "0.1.0",
  "description": "Docs-as-code engine: Markdown with bracketed provision IDs to Typst PDFs and a JSON manifest.",
  "type": "module",
  "license": "MPL-2.0",
  "repository": { "type": "git", "url": "https://github.com/jackkoskie/docengine.git", "directory": "packages/cli" },
  "bin": {
    "docengine": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/copy-templates.mjs && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@jackkoskie/docengine-core": "workspace:*",
    "jiti": "^2.7.0",
    "tinyglobby": "^0.2.17"
  }
}
