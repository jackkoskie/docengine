{
  "docengine frontmatter": {
    "prefix": "de-frontmatter",
    "description": "Document frontmatter and a first Section",
    "body": [
      "---",
      "title: ${1:Document title}",
      "short: ${2:short-name}",
      "group: ${3:group}",
      "version: \"${4:1.0}\"",
      "effectiveDate: ${5:${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}}",
      "description: ${6:One sentence summary.}",
      "---",
      "",
      "[${7:602.01}] # ${8:Section title}",
      "",
      "[${7:602.01}(1)] $0"
    ]
  },
  "docengine part": {
    "prefix": "de-part",
    "description": "Declare a Part heading (optional)",
    "body": [
      "[${1:6}] # ${2:Part title}",
      "",
      "$0"
    ]
  },
  "docengine subpart": {
    "prefix": "de-subpart",
    "description": "Declare a Subpart heading (optional)",
    "body": [
      "[${1:602}] # ${2:Subpart title}",
      "",
      "$0"
    ]
  },
  "docengine section": {
    "prefix": "de-section",
    "description": "New Section",
    "body": [
      "[${1:602.60}] # ${2:Section title}",
      "",
      "[${1:602.60}(1)] $0"
    ]
  },
  "docengine subsection": {
    "prefix": "de-subsection",
    "description": "New Subsection, for example (1)",
    "body": [
      "[${1:602.60}(${2:1})] $0"
    ]
  },
  "docengine paragraph": {
    "prefix": "de-paragraph",
    "description": "New Paragraph, for example (a)",
    "body": [
      "[${1:602.60}(${2:1})(${3:a})] $0"
    ]
  },
  "docengine subparagraph": {
    "prefix": "de-subparagraph",
    "description": "New Subparagraph, for example (i)",
    "body": [
      "[${1:602.60}(${2:1})(${3:a})(${4:i})] $0"
    ]
  },
  "docengine clause": {
    "prefix": "de-clause",
    "description": "New Clause (level 7), for example (A)",
    "body": [
      "[${1:602.60}(${2:1})(${3:a})(${4:i})(${5:A})] $0"
    ]
  },
  "docengine subclause": {
    "prefix": "de-subclause",
    "description": "New Subclause (level 8), for example (I)",
    "body": [
      "[${1:602.60}(${2:1})(${3:a})(${4:i})(${5:A})(${6:I})] $0"
    ]
  },
  "docengine provision (explicit ID)": {
    "prefix": "de-provision",
    "description": "New provision with an explicit ID",
    "body": [
      "[${1:602.60(1)}] $0"
    ]
  },
  "docengine repealed provision": {
    "prefix": "de-repealed",
    "description": "Tombstone for a repealed provision (IDs are never reused)",
    "body": [
      "[${1:602.60(1)}] [repealed] ${2:Repealed by PR #}"
    ]
  },
  "docengine reference": {
    "prefix": "de-ref",
    "description": "Reference to a provision",
    "body": [
      "[[${1:602.60(1)}]]"
    ]
  },
  "docengine cross-document reference": {
    "prefix": "de-xref",
    "description": "Reference to a provision in another document",
    "body": [
      "[[${1:other-doc}#${2:602.60(1)}]]"
    ]
  },
  "docengine figure": {
    "prefix": "de-figure",
    "description": "Figure with a stable key",
    "body": [
      "![${1:Caption and alt text}](${2:images/figure.svg}){#fig:${3:key} width=${4:80%}}"
    ]
  },
  "docengine figure reference": {
    "prefix": "de-figref",
    "description": "Reference to a figure",
    "body": [
      "[[fig:${1:key}]]"
    ]
  },
  "docengine titled provision": {
    "prefix": "de-title",
    "description": "Provision with a title (body on following lines)",
    "body": [
      "[${1:602.60(1)}] # ${2:Title}",
      "${3:Body.}",
      "",
      "$0"
    ]
  },
  "docengine footnote reference": {
    "prefix": "de-footnote",
    "description": "Footnote reference",
    "body": [
      "[^${1:1}]"
    ]
  },
  "docengine footnote definition": {
    "prefix": "de-footnote-def",
    "description": "Footnote definition (continue on indented lines)",
    "body": [
      "[^${1:1}]: ${2:Footnote text.}",
      "",
      "$0"
    ]
  },
  "docengine underline": {
    "prefix": "de-underline",
    "description": "Underlined text",
    "body": [
      "++${1:text}++"
    ]
  },
  "docengine highlight": {
    "prefix": "de-highlight",
    "description": "Highlighted text",
    "body": [
      "==${1:text}=="
    ]
  },
  "docengine keep with next": {
    "prefix": "de-keep",
    "description": "Provision kept together with the next block ({break} allows a page break)",
    "body": [
      "[${1:602.60}]{keep} # ${2:Section title}",
      "${3:Body.}",
      "",
      "$0"
    ]
  }
}
