{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "effectiveDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "short": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "cover": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "draft": {
      "type": "boolean"
    },
    "effectiveTime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3])[0-5]\\dZ$"
    },
    "expiryDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "numbering": {},
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "toc": {
      "type": "boolean"
    },
    "version-note": {
      "const": "editorial"
    }
  },
  "required": [
    "effectiveDate",
    "group",
    "short",
    "title",
    "version"
  ],
  "title": "docengine document frontmatter",
  "additionalProperties": false
}
